{
  "name": "delta",
  "version": "1.14.10",
  "scripts": {
    "ng": "ng",
    "build": "ng build --configuration development && node ./node_modules/typescript/lib/tsc -p tsconfig.server.json",
    "build:prod": "ng build --configuration production && node ./node_modules/typescript/lib/tsc  -p tsconfig.server.json",
    "build:22": "npm run ng -- build --configuration development && node ./node_modules/typescript/bin/tsc -p tsconfig.server.json",
    "build:prod:22": "npm run ng -- build --configuration production && node ./node_modules/typescript/bin/tsc -p tsconfig.server.json",
    "start": "npm run build:prod && npm run start:main",
    "start:main": "node --inspect server.js",
    "start:dev": "npm run build && nodemon",
    "start:ng": "ng serve",
    "lint": "ng lint",
    "prettier": "node ./node_modules/prettier/bin-prettier.js --write ./src/**/*.ts",
    "test": "npm run test:backend && npm run test:frontend-once",
    "test:frontend": "ng test",
    "test:frontend-once": "ng test --watch false",
    "test:backend": "npx mocha --require ts-node/register --extensions ts 'src/server/**/*.test.ts'", 
    "coverage:node": "node ./node_modules/nyc/bin/nyc npm run test:backend",
    "coverage:frontend": "ng test --code-coverage --watch=false --karma-config=karma.conf.js",
    "e2e": "npx playwright test --config=playwright.config.ts",
    "open:coverage": "start ./coverage/index.html"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "nyc": {
    "all": true,
    "cache": false,
    "instrument": true,
    "sourceMap": true,
    "exclude-after-remap": false,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/app/**/*.ts"
    ],
    "extension": [
      ".ts"
    ],
    "require": [
      "ts-node/register",
      "source-map-support/register"
    ],
    "reporter": [
      "text",
      "text-summary",
      "html"
    ]
  },
  "author": "mycomplexsoul",
  "dependencies": {
    "@angular/animations": "22.1.2",
    "@angular/cdk": "22.1.1",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/platform-browser-dynamic": "22.1.2",
    "@angular/router": "22.1.2",
    "@angular/service-worker": "22.1.2",
    "@types/cors": "^2.8.18",
    "chart.js": "4.4.2",
    "chartjs-adapter-date-fns": "^3.0.0",
    "core-js": "3.50.0",
    "cors": "^2.8.5",
    "date-fns": "^2.29.3",
    "express": "4.22.2",
    "html2canvas": "^1.0.0-rc.5",
    "jsonwebtoken": "^9.0.0",
    "jspdf": "^3.0.1",
    "mysql": "2.18.1",
    "ng2-charts": "5.0.4",
    "nodemailer": "6.9.13",
    "rxjs": "7.8.2",
    "tslib": "^2.0.0",
    "typescript": "6.0.3",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@angular/language-service": "22.1.2",
    "@playwright/test": "^1.56.1",
    "@types/chart.js": "2.9.41",
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "^4.17.33",
    "@types/jasmine": "~5.1.0",
    "@types/jasminewd2": "2.0.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.0",
    "chai": "5.3.3",
    "istanbul": "0.4.5",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.13.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "mocha": "^10.8.2",
    "nodemon": "^3.0.1",
    "nyc": "15.1.0",
    "prettier": "2.8.8",
    "protractor": "^7.0.0",
    "source-map-support": "0.5.21",
    "ts-node": "10.9.2",
    "tslint": "6.1.3"
  },
  "prettier": {
    "tabWidth": 2
  }
}
